# ============================================================================
# Robah Plus — environment template  (values are NEVER committed; copy to .env)
# ----------------------------------------------------------------------------
# Naming convention:
#   * `SUPABASE_*`            → the standard Supabase CLI / GitHub Actions names
#   * `FOX_*`                 → Robah Plus specific
# Nothing in this file is a secret. Fill the real values only in
#   · GitHub → Settings → Secrets and variables → Actions   (for CI/CD)
#   · Supabase → Project Settings → API Keys / Edge Functions → Secrets
#   · the APK build machine → local .env only
# ============================================================================

# ── Supabase project (shared by web, APK and CI) ─────────────────────────────
# The publishable/anon key is safe for browsers and the APK: every read/write it
# can perform is still governed by RLS.  The service-role key is NOT: it must never
# appear in a client bundle, in the APK, or in git.
SUPABASE_PROJECT_REF=
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgres://postgres.your_project_ref:CHANGE-ME@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# ── legacy Cloudflare hosting (kept: web assets still live on the Worker) ────
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ── edge-function secrets (set with `supabase secrets set …`, not here) ──────
# Admin code: a second factor for the admin-only actions inside edge functions.
FOX_ADMIN_CODE=
# Extra proof required before a balance may be minted for ANOTHER user (app.wallet_apply).
FOX_WALLET_ADMIN_CODE=
# AI gateway (the Worker used to carry this key inline — it must not any more).
AI_GATEWAY_URL=
AI_GATEWAY_KEY=
# Firebase Cloud Messaging v1 (APK push). Use the whole JSON, not individual fields.
FCM_SERVICE_ACCOUNT_JSON=
FCM_SENDER_ID=
# Payment gateway (diamond packs). Confirmations call /functions/v1/wallet {action:confirm-payment}.
PAYMENT_GATEWAY_WEBHOOK_SECRET=
TZ=Asia/Tehran

# ── web build (apps/web) — public by definition, no secrets here ─────────────
# Which backend the browser/APK talks to.  Same-origin (empty) means "the edge
# functions live under /functions/v1 on this very host".
FOX_PROJECT_URL=
FOX_API_BASE=
# Set false only for a throwaway preview; production must never trust a local balance.
FOX_SERVER_WALLET=true

# ── APK / mobile ─────────────────────────────────────────────────────────────
# The APK gets URL + publishable key ONLY.  No service-role key, no admin code.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_APP_ENV=production
